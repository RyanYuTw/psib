<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PSIB.ViewModels"
             xmlns:models="clr-namespace:PSIB.Models"
             x:Class="PSIB.Views.Vendors.VendorListPage"
             x:DataType="vm:VendorListViewModel"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto,*,Auto">
        <SearchBar Grid.Row="0" Text="{Binding SearchKeyword}" Placeholder="搜尋廠商名稱或電話..."
                   Style="{StaticResource SearchBar}" SearchCommand="{Binding SearchCommand}" />
        <CollectionView Grid.Row="1" ItemsSource="{Binding Vendors}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Vendor">
                    <Frame Style="{StaticResource CardFrame}">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Name}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                <HorizontalStackLayout Spacing="12">
                                    <Label Text="{Binding Id, StringFormat='編號: {0}'}" Style="{StaticResource SectionLabel}" />
                                    <Label Text="{Binding BusinessNo, StringFormat='統編: {0}'}" Style="{StaticResource SectionLabel}"
                                           IsVisible="{Binding BusinessNo, Converter={StaticResource StringNotEmptyConverter}}" />
                                </HorizontalStackLayout>
                                <Label Text="{Binding Phone, StringFormat='電話: {0}'}" FontSize="13" TextColor="{StaticResource TextSecondary}"
                                       IsVisible="{Binding Phone, Converter={StaticResource StringNotEmptyConverter}}" />
                            </VerticalStackLayout>
                            <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                <Button Text="編輯"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:VendorListViewModel}}, Path=EditCommand}"
                                        CommandParameter="{Binding .}" Style="{StaticResource SecondaryButton}" />
                                <Button Text="刪除"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:VendorListViewModel}}, Path=DeleteCommand}"
                                        CommandParameter="{Binding .}" Style="{StaticResource DangerButton}" />
                            </HorizontalStackLayout>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <Label Text="目前無廠商資料" TextColor="{StaticResource TextSecondary}"
                       HorizontalOptions="Center" VerticalOptions="Center" Margin="0,40" />
            </CollectionView.EmptyView>
        </CollectionView>
        <Button Grid.Row="2" Text="+ 新增廠商" Command="{Binding AddCommand}"
                Style="{StaticResource PrimaryButton}" Margin="16,8" />
        <ActivityIndicator Grid.Row="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                           Color="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
    </Grid>
</ContentPage>
