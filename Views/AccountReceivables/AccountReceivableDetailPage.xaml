<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PSIB.ViewModels"
             x:Class="PSIB.Views.AccountReceivables.AccountReceivableDetailPage"
             x:DataType="vm:AccountReceivableDetailViewModel"
             Title="{Binding Title}">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="帳款資訊" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                    <Label Text="帳款編號" Style="{StaticResource SectionLabel}" />
                    <Entry Text="{Binding Id}" IsReadOnly="True" Style="{StaticResource FormEntry}" BackgroundColor="{StaticResource Gray100}" />
                    <Label Text="客戶" Style="{StaticResource SectionLabel}" />
                    <Entry Text="{Binding CustomerName}" IsReadOnly="True" Style="{StaticResource FormEntry}" BackgroundColor="{StaticResource Gray100}" />
                    <Label Text="收款日期" Style="{StaticResource SectionLabel}" />
                    <DatePicker x:Name="ReceiveDatePicker" Format="yyyy/MM/dd" />
                    <Label Text="現金收款" Style="{StaticResource SectionLabel}" />
                    <Entry Text="{Binding ReceiveCash}" Keyboard="Numeric" Placeholder="0" Style="{StaticResource FormEntry}" />
                    <Label Text="收款金額" Style="{StaticResource SectionLabel}" />
                    <Entry Text="{Binding ReceiveAmount}" Keyboard="Numeric" Placeholder="0" Style="{StaticResource FormEntry}" />
                    <Label Text="餘額" Style="{StaticResource SectionLabel}" />
                    <Entry Text="{Binding TotalBalance}" Keyboard="Numeric" Placeholder="0" Style="{StaticResource FormEntry}" />
                    <Label Text="備註" Style="{StaticResource SectionLabel}" />
                    <Editor Text="{Binding Memo}" Placeholder="選填" HeightRequest="80" BackgroundColor="White" />
                </VerticalStackLayout>
            </Frame>
            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" FontSize="13"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,8">
                <Button Text="取消" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" />
                <Button Grid.Column="1" Text="儲存" Command="{Binding SaveCommand}"
                        Style="{StaticResource PrimaryButton}" IsEnabled="{Binding IsNotBusy}" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
